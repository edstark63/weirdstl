{{- $pages := where site.RegularPages "Type" "in" (slice "historical" "current") -}}
{{- if and (ne .Kind "home") (ne .Kind "page") -}}{{- $pages = where .Pages "Type" "in" (slice "historical" "current") -}}{{- end -}}
{{- $pages = first 50 $pages.ByDate.Reverse -}}
<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if eq .Title .Site.Title }}{{ .Site.Title }}{{ else }}{{ with .Title }}{{ . }} on {{ end }}{{ .Site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Site.Params.homeDescription | default .Site.Params.description }}</description>
    <generator>Hugo</generator>
    <language>{{ site.Language.LanguageCode | default "en-us" }}</language>
    {{- with $pages }}<lastBuildDate>{{ (index . 0).Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>{{ end }}
    {{ with .OutputFormats.Get "RSS" }}{{ printf "<atom:link href=%q rel=\"self\" type=%q />" .Permalink .MediaType | safeHTML }}{{ end }}
    {{ range $pages }}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ (.Params.description | default (.Summary | plainify | truncate 300)) | html }}</description>
    </item>
    {{ end }}
  </channel>
</rss>
